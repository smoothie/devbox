#!/usr/bin/env bash
set -euo pipefail
export HOME={{ pi_home | quote }}
export PI_CODING_AGENT_DIR={{ pi_agent_dir | quote }}
{% if item == 'pi' %}
export PI_TELEMETRY={{ (pi_enable_install_telemetry | bool | ternary('true', 'false')) | quote }}
{% endif %}
export PATH={{ (pi_install_dir ~ '/node/bin:' ~ pi_install_dir ~ '/npm/bin:') | quote }}"$PATH"
exec {{ (pi_install_dir ~ '/npm/bin/' ~ item) | quote }} "$@"
