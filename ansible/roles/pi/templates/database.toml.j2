[[sources]]
id = {{ item.name | to_json }}
dsn = {{ item.dsn | to_json }}
lazy = true
connection_timeout = {{ item.connection_timeout | default(10) | int }}
query_timeout = {{ item.query_timeout | default(30) | int }}

[[tools]]
name = "execute_sql"
source = {{ item.name | to_json }}
readonly = {{ item.readonly | default(true) | bool | lower }}
max_rows = {{ item.max_rows | default(1000) | int }}

[[tools]]
name = "search_objects"
source = {{ item.name | to_json }}
